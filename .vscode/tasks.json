{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "backend.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "tabName": "AI Backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 0,
          "location": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started reloader process",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "Start Ollama",
      "type": "shell",
      "command": "ollama",
      "args": ["serve"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "tabName": "Ollama"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start All (Ollama + Backend)",
      "dependsOn": ["Start Ollama", "Start Backend"],
      "dependsOrder": "sequence",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
